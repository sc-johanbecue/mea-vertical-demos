{
  "$schema": "../../../.sitecore/schemas/ModuleFile.schema.json",
  "namespace": "british-council-scs",
  "items": {
    "path": "serialized-content",
    "includes": [
      {
        "name": "templates",
        "path": "/sitecore/templates/Project/british-council",
        "allowedPushOperations": "CreateUpdateAndDelete",
        "scope": "ItemAndDescendants"
      },
      {
        "name": "branches",
        "path": "/sitecore/templates/Branches/Project/british-council",
        "allowedPushOperations": "CreateUpdateAndDelete",
        "scope": "ItemAndDescendants"
      },
      {
        "name": "media-library",
        "path": "/sitecore/media library/Project/british-council",
        "scope": "ItemAndDescendants"
      },
      {
        "name": "renderings",
        "path": "/sitecore/Layout/Renderings/Project/british-council",
        "allowedPushOperations": "CreateUpdateAndDelete",
        "scope": "ItemAndDescendants"
      },
      {
        "name": "placeholder-settings",
        "path": "/sitecore/Layout/Placeholder Settings/Project/british-council",
        "allowedPushOperations": "CreateUpdateAndDelete",
        "scope": "ItemAndDescendants"
      },
      {
        "name": "project-settings",
        "path": "/sitecore/system/Settings/Project/british-council",
        "allowedPushOperations": "CreateUpdateAndDelete",
        "scope": "ItemAndDescendants"
      },
      {
        "name": "collection",
        "path": "/sitecore/content/british-council/",
        "allowedPushOperations": "CreateUpdateAndDelete",
        "scope": "SingleItem"
      },
      {
        "name": "british-council",
        "path": "/sitecore/content/british-council/british-council",
        "allowedPushOperations": "CreateAndUpdate",
        "rules": [
          {
            "path": "/home",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Media",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Data",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Dictionary",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Presentation",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Settings/Site Grouping",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Settings",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "*",
            "scope": "Ignored"
          }
        ]
      }
    ]
  }
}
