{
  "$schema": "../.sitecore/schemas/ModuleFile.schema.json",
  "namespace": "kpmgProject",
  "items": {
    "path": "kpmg",
    "includes": [
      {
        "name": "templatesProject",
        "path": "/sitecore/templates/Project/kpmg",
        "allowedPushOperations": "CreateUpdateAndDelete",
        "scope": "ItemAndDescendants"
      },
      {
        "name": "branchesProject",
        "path": "/sitecore/templates/Branches/Project/kpmg",
        "allowedPushOperations": "CreateUpdateAndDelete",
        "scope": "ItemAndDescendants"
      },
      {
        "name": "projectRenderings",
        "path": "/sitecore/Layout/Renderings/Project/kpmg",
        "allowedPushOperations": "CreateUpdateAndDelete",
        "scope": "ItemAndDescendants"
      },
      {
        "name": "projectPlaceholderSettings",
        "path": "/sitecore/Layout/Placeholder Settings/Project/kpmg",
        "allowedPushOperations": "CreateUpdateAndDelete",
        "scope": "ItemAndDescendants"
      },
      {
        "name": "site",
        "path": "/sitecore/content/kpmg/kpmgbeyond",
        "rules": [
          {
            "path": "/home",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Media",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Data",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Dictionary",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Presentation",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Settings/Site Grouping",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Settings",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "*",
            "scope": "Ignored"
          }
        ]
      }
    ]
  }
}
